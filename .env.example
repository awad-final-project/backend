# ======================
# DATABASE CONFIGURATION
# ======================
MONGODB_URI=mongodb://localhost:27017/email_system

# ======================
# JWT CONFIGURATION
# ======================
# Minimum 32 characters recommended for production
JWT_SECRET=your-secret-key-please-change-this-to-a-long-random-string

# ======================
# SERVER CONFIGURATION
# ======================
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ======================
# GOOGLE OAUTH2
# ======================
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ======================
# SYSTEM EMAIL (SMTP) - OPTIONAL
# ======================
# ⚠️ CHÚ Ý: Phần này là TÙY CHỌN!
# 
# Nếu KHÔNG config:
#   ✅ Đăng ký/đăng nhập vẫn hoạt động bình thường
#   ❌ Không có welcome email
#   ❌ Không dùng được password reset
#
# Nếu CÓ config:
#   ✅ Có welcome email khi đăng ký
#   ✅ Có password reset qua email
#
# Dùng để: Gửi welcome emails, password reset emails, notifications
# Chỉ cần: 1 email duy nhất cho toàn hệ thống (VD: noreply@yourapp.com)
# 
# ❓ User gửi/nhận email của họ có cần config này không?
# ✅ KHÔNG! User tự cung cấp email khi dùng, không cần config ở đây.
#
# Để test nhanh: Comment hoặc xóa các dòng dưới đây
# Để test đầy đủ: Uncomment và điền thông tin

# Gmail configuration (khuyến nghị cho test)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-system-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password  # 16 chars từ https://myaccount.google.com/apppasswords
MAIL_FROM="Your App Name <noreply@yourapp.com>"

# Alternative cho Outlook:
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_USER=your-email@outlook.com
# MAIL_PASSWORD=your-outlook-app-password

# Alternative cho Mailtrap (test mà không gửi email thật):
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USER=your-mailtrap-username
# MAIL_PASSWORD=your-mailtrap-password
# Đăng ký: https://mailtrap.io

# ======================
# IMAP CONFIGURATION - OPTIONAL
# ======================
# ⚠️ CHÚ Ý: Phần này cũng là TÙY CHỌN!
#
# Dùng để: Auto-fetch emails định kỳ (cron job)
# Không bắt buộc: User vẫn gửi/nhận email bình thường mà không cần config này
#
# Nếu KHÔNG config:
#   ✅ User vẫn gửi/nhận email (user tự cung cấp credentials)
#   ❌ Không có auto-fetch emails trong background
#
# Để test: Có thể bỏ qua phần này hoàn toàn

# Gmail IMAP
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-gmail-app-password
IMAP_TLS=true

# Alternative for Outlook:
# IMAP_HOST=outlook.office365.com
# IMAP_PORT=993
# IMAP_USER=your-email@outlook.com
# IMAP_PASSWORD=your-outlook-app-password

# ======================
# AWS S3 (for attachments)
# ======================
# Optional: For storing email attachments
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=your-bucket-name

# ======================
# AUTHENTICATION OPTIONS
# ======================
# Set to 'true' to use httpOnly cookies for refresh tokens
# Set to 'false' to return tokens in response body
USE_COOKIE_AUTH=false

# ======================
# NOTES - ĐỌC KỸ TRƯỚC KHI BẮT ĐẦU
# ======================
#
# 📧 2 LOẠI EMAIL TRONG HỆ THỐNG:
# 
# 1️⃣ SYSTEM EMAILS (config ở trên - OPTIONAL):
#    - Welcome email, password reset
#    - Chỉ cần 1 email cho toàn hệ thống
#    - Có thể bỏ qua khi test
#
# 2️⃣ USER EMAILS (KHÔNG config ở đây):
#    - User gửi/nhận email từ Gmail/Outlook của họ
#    - User tự cung cấp credentials khi dùng
#    - Không cần host email
#
# 🚀 TEST NHANH (không cần email):
#    - Comment MAIL_* và IMAP_* configs
#    - Đăng ký/đăng nhập vẫn hoạt động
#    - User vẫn gửi/nhận email (nếu họ cung cấp credentials)
#
# 📖 Chi tiết: Xem file EMAIL_CONFIG_GUIDE.md
#
# 1. Gmail App Password Guide:
#    - Enable 2FA: https://myaccount.google.com/security
#    - Create App Password: https://myaccount.google.com/apppasswords
#    - Use 16-character password (no spaces)
#
# 2. Outlook App Password Guide:
#    - Enable 2FA: https://account.microsoft.com/security
#    - Create App Password in Advanced Security Options
#
# 3. For production:
#    - Change NODE_ENV to 'production'
#    - Use strong, random JWT_SECRET (min 32 chars)
#    - Enable HTTPS and set secure cookies
#    - Use environment-specific URLs
#    - Consider SendGrid, AWS SES, or Mailgun for emails
#
# 4. MongoDB:
#    - For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/dbname
#    - For local: mongodb://localhost:27017/dbname
